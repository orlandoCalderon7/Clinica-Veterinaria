# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# ── Compiled output ───────────────────────────────────────────
/dist
/tmp
/out-tsc
/bazel-out

# ── Node ──────────────────────────────────────────────────────
/node_modules
npm-debug.log
yarn-error.log
package-lock.json        
yarn.lock                

# ── Angular ───────────────────────────────────────────────────
/.angular/cache          
.angular/                

# ── IDEs and editors ──────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.suo                    
*.ntvs*                  
*.njsproj                
*.sln                    

# ── Visual Studio Code ────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# ── Testing & Coverage ────────────────────────────────────────
/coverage                
testem.log
karma-results/           
/test-results/           

# ── Environments (seguridad) ──────────────────────────────────
src/environments/*.local.ts   
.env                          
.env.local                    
.env.development              
.env.production               

# ── Logs ──────────────────────────────────────────────────────
*.log                    
logs/                    
npm-debug.log
yarn-error.log

# ── Miscellaneous ─────────────────────────────────────────────
/.angular/cache
.sass-cache/
/connect.lock
/libpeerconnection.log
/typings

# ── System files ──────────────────────────────────────────────
.DS_Store                
Thumbs.db                
Desktop.ini              
$RECYCLE.BIN/           
*.pem                    
